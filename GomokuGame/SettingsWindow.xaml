<Window x:Class="GomokuGame.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<Window.Resources>
		<!-- Шаблон элемента палитры (свотч + название) -->
		<DataTemplate x:Key="ColorItemTemplate">
			<StackPanel Orientation="Horizontal">
				<Border Width="20" Height="20"
                        CornerRadius="3"
                        BorderBrush="#666" BorderThickness="1"
                        Background="{Binding Brush}"/>
				<TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
			</StackPanel>
		</DataTemplate>
	</Window.Resources>

	<Grid Margin="20" MinWidth="360">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/><!-- размер поля -->
			<RowDefinition Height="Auto"/><!-- win length -->
			<RowDefinition Height="Auto"/><!-- цвет X -->
			<RowDefinition Height="Auto"/><!-- цвет O -->
			<RowDefinition Height="Auto"/><!-- X: игрок/комп -->
			<RowDefinition Height="Auto"/><!-- O: игрок/комп -->
			<RowDefinition Height="Auto"/><!-- имя ai -->
			<RowDefinition Height="Auto"/><!-- вкл/выкл лог -->
			<RowDefinition Height="Auto"/><!-- кнопки -->
		</Grid.RowDefinitions>

		<!-- Размер поля -->
		<StackPanel Grid.Row="0" Margin="0,0,0,12">
			<TextBlock Text="Размер поля (5–30):" FontWeight="SemiBold"/>
			<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
				<Slider Minimum="5" Maximum="30"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Width="200"
                        Value="{Binding BoardSize}"/>
				<TextBlock Text="{Binding BoardSize}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontWeight="Bold"/>
			</StackPanel>
		</StackPanel>

		<!-- Длина выигрышной линии -->
		<StackPanel Grid.Row="1" Margin="0,0,0,12">
			<TextBlock Text="Длина выигрышной линии:" FontWeight="SemiBold"/>
			<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
				<Slider Minimum="3" Maximum="{Binding MaxWinLength}"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Width="200"
                        Value="{Binding WinLength}"/>
				<TextBlock Text="{Binding WinLength}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontWeight="Bold"/>
			</StackPanel>
		</StackPanel>

		<!-- Цвет крестиков -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
			<TextBlock Text="Цвет крестиков:" VerticalAlignment="Center" Width="140"/>
			<ComboBox Width="160"
                      ItemsSource="{Binding Palette}"
                      SelectedItem="{Binding XColor}"
                      ItemTemplate="{StaticResource ColorItemTemplate}"/>
		</StackPanel>

		<!-- Цвет ноликов -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
			<TextBlock Text="Цвет ноликов:" VerticalAlignment="Center" Width="140"/>
			<ComboBox Width="160"
                      ItemsSource="{Binding Palette}"
                      SelectedItem="{Binding OColor}"
                      ItemTemplate="{StaticResource ColorItemTemplate}"/>
		</StackPanel>

		<!-- кто играет -->
		<!-- Крестики -->
		<StackPanel Grid.Row="4" Margin="0,0,0,12">
			<TextBlock Text="Крестики:" FontWeight="SemiBold"/>
			<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
				<RadioButton Content="Человек" GroupName="XPlayer"
                     IsChecked="{Binding IsXHuman}"
                     Margin="0,0,12,0" VerticalAlignment="Center"/>
				<RadioButton Content="Компьютер" GroupName="XPlayer"
                     IsChecked="{Binding IsXComputer}"
                     VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>

		<!-- Нолики -->
		<StackPanel Grid.Row="5" Margin="0,0,0,12">
			<TextBlock Text="Нолики:" FontWeight="SemiBold"/>
			<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
				<RadioButton Content="Человек" GroupName="OPlayer"
                     IsChecked="{Binding IsOHuman}"
                     Margin="0,0,12,0" VerticalAlignment="Center"/>
				<RadioButton Content="Компьютер" GroupName="OPlayer"
                     IsChecked="{Binding IsOComputer}"
                     VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>

		<!-- Выбор сети -->
		<StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,20">
			<TextBlock Text="Сеть:" VerticalAlignment="Center" Width="140"/>
			<ComboBox Width="220"
              ItemsSource="{Binding AvailableNetworks}"
              SelectedItem="{Binding SelectedNetwork}"
              IsEnabled="{Binding AnyComputer}"/>
		</StackPanel>

		<!-- Лог партий -->
		<StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,20">
			<TextBlock Text="Лог партий:" VerticalAlignment="Center" Width="140"/>
			<CheckBox Content="Вести лог в текстовый файл"
              IsChecked="{Binding EnableGameLog}"
              VerticalAlignment="Center"/>
		</StackPanel>

		<!-- Кнопки -->
		<StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Сохранить" Width="90" Margin="0,0,8,0"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"/>
			<Button Content="Отмена" Width="90"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>
		</StackPanel>
	</Grid>
</Window>