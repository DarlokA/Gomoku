<Window x:Class="GomokuGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GomokuGame.ViewModels"
        xmlns:conv="clr-namespace:GomokuGame.Converters"
        Title="Крестики-нолики 5 в ряд"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>

	<Window.Resources>
		<conv:CellStateToBrushConverter x:Key="CellStateToBrush"/>

		<Style x:Key="CellButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="38"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Background" Value="#FFF3E0"/>
			<Setter Property="BorderBrush" Value="#8D6E63"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource CellStateToBrush}">
						<Binding Path="State"/>
						<Binding Path="DataContext.XColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
						<Binding Path="DataContext.OColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="CellBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#FFE0B2"/>
							</Trigger>

							<!-- Подсветка выигрышной клетки -->
							<DataTrigger Binding="{Binding IsWinning}" Value="True">
								<Setter TargetName="CellBorder" Property="Background" Value="#A5D6A7"/>
								<Setter TargetName="CellBorder" Property="BorderBrush" Value="#2E7D32"/>
								<Setter TargetName="CellBorder" Property="BorderThickness" Value="2"/>
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="10" x:Name="RootGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель: статус, кнопки -->
		<StackPanel Cursor="Hand" x:Name="TopPanel" Grid.Row="0" Orientation="Horizontal"
                HorizontalAlignment="Center" Margin="0,5,0,10">
			<TextBlock Cursor="Hand" x:Name="StatusTextBlock"
                   Text="{Binding StatusText}" FontSize="20"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
			<Button Cursor="Hand" Content="Новая игра" Command="{Binding NewGameCommand}"
                Margin="20,0,0,0" Padding="15,5" FontSize="14"/>
			<Button Cursor="Hand" Content="Настройки" Command="{Binding OpenSettingsCommand}" 
                Margin="8,0,0,0" Padding="15,5" FontSize="14"/>
			<Button Cursor="Hand" Content="Обучение" Command="{Binding OpenTrainerCommand}"
				Margin="8,0,0,0" Padding="15,5" FontSize="14"/>
		</StackPanel>

		<!-- Текущий игрок -->
		<TextBlock x:Name="CurrentPlayerTextBlock" Grid.Row="1"
               HorizontalAlignment="Center"
               Margin="0,0,0,10" FontSize="16">
			<Run Text="Сейчас ходят:"/>
			<Run Text="{Binding CurrentPlayerDisplay, Mode=OneWay}"
             FontWeight="Bold" Foreground="#D32F2F"/>
		</TextBlock>

		<!-- Игровое поле -->
		<ItemsControl x:Name="BoardControl" Grid.Row="2"
                  ItemsSource="{Binding Cells}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Rows="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Button Style="{StaticResource CellButtonStyle}"
                            Content="{Binding Display}"
                            Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</Window>