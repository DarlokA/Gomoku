<Window x:Class="GomokuGame.TrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обучение / Трейнер"
        Width="680" Height="640"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Путь к exe -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
			<TextBlock Text="Trainer.exe:" VerticalAlignment="Center" Width="100"/>
			<TextBox Width="360" Text="{Binding TrainerExePath}"/>
			<Button Content="Обзор..." Margin="8,0,0,0" Padding="10,2" Command="{Binding BrowseExeCommand}"/>
		</StackPanel>

		<!-- Режим -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
			<TextBlock Text="Режим:" VerticalAlignment="Center" Width="100"/>
			<RadioButton Content="Обучение (train)" GroupName="TrainerMode"
                         IsChecked="{Binding IsTrainMode}" Margin="0,0,16,0" VerticalAlignment="Center"/>
			<RadioButton Content="Матч сетей (match)" GroupName="TrainerMode"
                         IsChecked="{Binding IsMatchMode}" VerticalAlignment="Center"/>
		</StackPanel>

		<!-- Параметры -->
		<Grid Grid.Row="2" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Размер поля:" Width="120" VerticalAlignment="Center"/>
					<TextBox Width="80" Text="{Binding BoardSize, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Длина линии:" Width="120" VerticalAlignment="Center"/>
					<TextBox Width="80" Text="{Binding WinLength, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Партий:" Width="120" VerticalAlignment="Center"/>
					<TextBox Width="80" Text="{Binding Games, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsGamesEditable}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<CheckBox Content="Бесконечное обучение (до Ctrl+C)" IsChecked="{Binding IsInfinite}"/>
				</StackPanel>

				<StackPanel Visibility="{Binding IsTrainMode, Converter={StaticResource BoolToVis}}">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="LR:" Width="120" VerticalAlignment="Center"/>
						<TextBox Width="80" Text="{Binding LearningRate, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Epsilon:" Width="120" VerticalAlignment="Center"/>
						<TextBox Width="80" Text="{Binding Epsilon, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Decay:" Width="120" VerticalAlignment="Center"/>
						<TextBox Width="80" Text="{Binding Decay, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1">
				<StackPanel Visibility="{Binding IsTrainMode, Converter={StaticResource BoolToVis}}">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Seed:" Width="110" VerticalAlignment="Center"/>
						<TextBox Width="100" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Режим (A-D):" Width="110" VerticalAlignment="Center"/>
						<ComboBox Width="100" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Chunk:" Width="110" VerticalAlignment="Center"/>
						<TextBox Width="100" Text="{Binding Chunk, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8"
								Visibility="{Binding IsLeagueMode, Converter={StaticResource BoolToVis}}">
						<TextBlock Text="WarmUp:" Width="110" VerticalAlignment="Center"/>
						<TextBox Width="100" Text="{Binding WarmupGames, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8"
								Visibility="{Binding IsLeagueMode, Converter={StaticResource BoolToVis}}">
						<TextBlock Text="Snapshot:" Width="110" VerticalAlignment="Center"/>
						<TextBox Width="100" Text="{Binding SnapshotEvery, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Алгоритм:" Width="110" VerticalAlignment="Center"/>
						<ComboBox Width="140" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Имя сети:" Width="110" VerticalAlignment="Center"/>
						<TextBox Width="160" Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<CheckBox Content="Показывать демо-партию" IsChecked="{Binding ShowDemo}" Margin="0,0,0,8"/>
				</StackPanel>

				<StackPanel Visibility="{Binding IsMatchMode, Converter={StaticResource BoolToVis}}">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Сеть X:" Width="110" VerticalAlignment="Center"/>
						<ComboBox Width="160" IsEditable="True" ItemsSource="{Binding AvailableNetworks}"
                                  Text="{Binding FileA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Сеть O:" Width="110" VerticalAlignment="Center"/>
						<ComboBox Width="160" IsEditable="True" ItemsSource="{Binding AvailableNetworks}"
                                  Text="{Binding FileB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</Grid>

		<!-- Превью командной строки -->
		<StackPanel Grid.Row="3" Margin="0,0,0,12">
			<TextBlock Text="Командная строка:" FontWeight="SemiBold"/>
			<TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" Background="#F2F2F2" Margin="0,4,0,0"/>
		</StackPanel>

		<!-- Кнопки -->
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
			<Button Content="Очистить лог" Width="110" Margin="0,0,8,0" Padding="0,4" Command="{Binding ClearLogCommand}"/>
			<Button Content="Остановить" Width="100" Margin="0,0,8,0" Padding="0,4" Command="{Binding StopCommand}"/>
			<Button Content="Запустить" Width="100" Padding="0,4" IsDefault="True" Command="{Binding StartCommand}"/>
		</StackPanel>

		<!-- Лог -->
		<Border Grid.Row="5" BorderBrush="#999" BorderThickness="1">
			<ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
				<TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         BorderThickness="0" Background="Black" Foreground="#D0FFD0"/>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>